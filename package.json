{
  "name": "teach-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "lessons/*"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "kit": "node scripts/build-kit.mjs",
    "test": "node scripts/verify-lessons.mjs",
    "check": "npm run typecheck && npm run lint && node scripts/build-kit.mjs --check && npm run test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "happy-dom": "^15.7.0"
  }
}
